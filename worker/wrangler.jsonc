{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "paper-reading-ai",
  "main": "index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "ANALYZE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}

